{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "trailingSlash": true,
  "cleanUrls": false,
  "redirects": [
    { "source": "/:path*", "has": [ { "type": "host", "value": "www.stratos.games" } ], "destination": "https://stratos.games/:path*", "permanent": true }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] },
    { "source": "/assets/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=86400" } ] },
    { "source": "/games/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=300" } ] }
  ]
}

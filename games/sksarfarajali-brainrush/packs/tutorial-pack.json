{"packId":"tutorial","packVersion":2,"scoringVersion":1,"date":"tutorial","number":0,"puzzles":[{"id":"tutorial-pattern","skill":"pattern","kind":"grid","prompt":"Which shape completes the grid?","cells":[{"shape":"triangle","tone":"blue"},{"shape":"circle","tone":"navy"},{"shape":"square","tone":"teal"},{"shape":"circle","tone":"navy"},{"shape":"square","tone":"teal"},{"shape":"triangle","tone":"blue"},{"shape":"square","tone":"teal"},null,{"shape":"circle","tone":"navy"}],"options":[{"shape":"square","tone":"teal"},{"shape":"circle","tone":"navy"},{"shape":"triangle","tone":"blue"},{"shape":"diamond","tone":"gold"}],"answer":2,"explanation":["Every row and every column uses each shape exactly once.","Its row already has the teal square and the navy circle.","Its column already has the navy circle and the teal square.","That leaves the blue triangle."]},{"id":"tutorial-sudoku","skill":"sudoku","prompt":"Fill the grid with 1 to 4","size":4,"boxR":2,"boxC":2,"givens":[0,0,4,0,2,0,0,1,4,1,2,3,3,2,0,0],"solution":[1,3,4,2,2,4,3,1,4,1,2,3,3,2,1,4],"explanation":["Every row, every column and every 2×2 box uses each number from 1 to 4 exactly once.","The finished grid:","Row 1: 1 3 4 2","Row 2: 2 4 3 1","Row 3: 4 1 2 3","Row 4: 3 2 1 4"]},{"id":"tutorial-logic","skill":"logic","prompt":"Crack the 3-digit code","clues":[{"guess":[3,9,4],"rightPlace":0,"wrongPlace":1},{"guess":[1,2,9],"rightPlace":0,"wrongPlace":0},{"guess":[8,1,3],"rightPlace":0,"wrongPlace":0},{"guess":[8,5,9],"rightPlace":0,"wrongPlace":0},{"guess":[6,1,7],"rightPlace":1,"wrongPlace":1}],"answer":[4,6,7],"explanation":["394: 4 is in the code but placed differently.","129: none of 1, 2, 9 appear in the code.","813: none of 8, 1, 3 appear in the code.","859: none of 8, 5, 9 appear in the code.","617: 7 is in the right spot; 6 is in the code but placed differently."],"hint":"The middle digit is even."}]}
{"packId":"daily-2026-11-08","packVersion":2,"scoringVersion":1,"date":"2026-11-08","number":53,"puzzles":[{"id":"2026-11-08-pattern","skill":"pattern","kind":"grid","prompt":"Which shape completes the grid?","cells":[{"shape":"circle","tone":"teal"},{"shape":"square","tone":"navy"},{"shape":"triangle","tone":"blue"},{"shape":"square","tone":"navy"},null,{"shape":"circle","tone":"teal"},{"shape":"triangle","tone":"blue"},{"shape":"circle","tone":"teal"},{"shape":"square","tone":"navy"}],"options":[{"shape":"circle","tone":"teal"},{"shape":"triangle","tone":"blue"},{"shape":"diamond","tone":"gold"},{"shape":"square","tone":"navy"}],"answer":1,"explanation":["Every row and every column uses each shape exactly once.","Its row already has the navy square and the teal circle.","Its column already has the navy square and the teal circle.","That leaves the blue triangle."]},{"id":"2026-11-08-sudoku","skill":"sudoku","prompt":"Fill the grid with 1 to 6","size":6,"boxR":2,"boxC":3,"givens":[5,3,1,0,0,4,6,0,0,0,0,0,0,6,0,0,0,0,0,1,2,0,5,3,0,0,0,1,4,6,1,0,0,3,2,0],"solution":[5,3,1,2,6,4,6,2,4,5,3,1,3,6,5,4,1,2,4,1,2,6,5,3,2,5,3,1,4,6,1,4,6,3,2,5],"explanation":["Every row, every column and every 2×3 box uses each number from 1 to 6 exactly once.","The finished grid:","Row 1: 5 3 1 2 6 4","Row 2: 6 2 4 5 3 1","Row 3: 3 6 5 4 1 2","Row 4: 4 1 2 6 5 3","Row 5: 2 5 3 1 4 6","Row 6: 1 4 6 3 2 5"]},{"id":"2026-11-08-logic","skill":"logic","prompt":"Crack the 3-digit code","clues":[{"guess":[6,9,7],"rightPlace":0,"wrongPlace":0},{"guess":[1,2,8],"rightPlace":2,"wrongPlace":0},{"guess":[1,4,7],"rightPlace":1,"wrongPlace":1},{"guess":[2,7,9],"rightPlace":0,"wrongPlace":1}],"answer":[1,2,4],"explanation":["697: none of 6, 9, 7 appear in the code.","128: 1, 2 are in the right spot.","147: 1 is in the right spot; 4 is in the code but placed differently.","279: 2 is in the code but placed differently."],"hint":"The last digit is even."}]}
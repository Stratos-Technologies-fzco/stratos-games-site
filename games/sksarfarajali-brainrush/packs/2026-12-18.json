{"packId":"daily-2026-12-18","packVersion":2,"scoringVersion":1,"date":"2026-12-18","number":93,"puzzles":[{"id":"2026-12-18-pattern","skill":"pattern","kind":"grid","prompt":"Which shape completes the grid?","cells":[{"shape":"circle","tone":"navy"},{"shape":"triangle","tone":"teal"},{"shape":"square","tone":"blue"},{"shape":"square","tone":"blue"},null,{"shape":"triangle","tone":"teal"},{"shape":"triangle","tone":"teal"},{"shape":"square","tone":"blue"},{"shape":"circle","tone":"navy"}],"options":[{"shape":"diamond","tone":"gold"},{"shape":"square","tone":"blue"},{"shape":"triangle","tone":"teal"},{"shape":"circle","tone":"navy"}],"answer":3,"explanation":["Every row and every column uses each shape exactly once.","Its row already has the blue square and the teal triangle.","Its column already has the teal triangle and the blue square.","That leaves the navy circle."]},{"id":"2026-12-18-sudoku","skill":"sudoku","prompt":"Fill the grid with 1 to 6","size":6,"boxR":2,"boxC":3,"givens":[5,0,6,0,0,0,3,2,0,6,0,0,2,0,0,4,0,0,0,1,4,3,2,0,0,3,2,0,4,6,0,0,0,0,0,2],"solution":[5,4,6,2,1,3,3,2,1,6,5,4,2,5,3,4,6,1,6,1,4,3,2,5,1,3,2,5,4,6,4,6,5,1,3,2],"explanation":["Every row, every column and every 2×3 box uses each number from 1 to 6 exactly once.","The finished grid:","Row 1: 5 4 6 2 1 3","Row 2: 3 2 1 6 5 4","Row 3: 2 5 3 4 6 1","Row 4: 6 1 4 3 2 5","Row 5: 1 3 2 5 4 6","Row 6: 4 6 5 1 3 2"]},{"id":"2026-12-18-logic","skill":"logic","prompt":"Crack the 3-digit code","clues":[{"guess":[7,9,6],"rightPlace":0,"wrongPlace":0},{"guess":[5,6,2],"rightPlace":1,"wrongPlace":0},{"guess":[4,7,0],"rightPlace":1,"wrongPlace":0},{"guess":[8,6,4],"rightPlace":0,"wrongPlace":2}],"answer":[4,8,2],"explanation":["796: none of 7, 9, 6 appear in the code.","562: 2 is in the right spot.","470: 4 is in the right spot.","864: 8, 4 are in the code but placed differently."],"hint":"The middle digit is even."}]}
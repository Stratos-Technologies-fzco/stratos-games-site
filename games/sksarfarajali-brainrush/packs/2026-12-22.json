{"packId":"daily-2026-12-22","packVersion":2,"scoringVersion":1,"date":"2026-12-22","number":97,"puzzles":[{"id":"2026-12-22-pattern","skill":"pattern","kind":"grid","prompt":"Which shape completes the grid?","cells":[{"shape":"circle","tone":"navy"},{"shape":"triangle","tone":"blue"},{"shape":"square","tone":"teal"},{"shape":"triangle","tone":"blue"},{"shape":"square","tone":"teal"},null,{"shape":"square","tone":"teal"},{"shape":"circle","tone":"navy"},{"shape":"triangle","tone":"blue"}],"options":[{"shape":"square","tone":"teal"},{"shape":"triangle","tone":"blue"},{"shape":"diamond","tone":"gold"},{"shape":"circle","tone":"navy"}],"answer":3,"explanation":["Every row and every column uses each shape exactly once.","Its row already has the blue triangle and the teal square.","Its column already has the teal square and the blue triangle.","That leaves the navy circle."]},{"id":"2026-12-22-sudoku","skill":"sudoku","prompt":"Fill the grid with 1 to 6","size":6,"boxR":2,"boxC":3,"givens":[3,0,0,0,5,0,2,0,0,4,6,0,1,2,0,0,0,6,6,0,3,0,0,0,0,1,0,6,0,4,0,0,0,5,2,1],"solution":[3,6,4,1,5,2,2,5,1,4,6,3,1,2,5,3,4,6,6,4,3,2,1,5,5,1,2,6,3,4,4,3,6,5,2,1],"explanation":["Every row, every column and every 2×3 box uses each number from 1 to 6 exactly once.","The finished grid:","Row 1: 3 6 4 1 5 2","Row 2: 2 5 1 4 6 3","Row 3: 1 2 5 3 4 6","Row 4: 6 4 3 2 1 5","Row 5: 5 1 2 6 3 4","Row 6: 4 3 6 5 2 1"]},{"id":"2026-12-22-logic","skill":"logic","prompt":"Crack the 3-digit code","clues":[{"guess":[3,2,1],"rightPlace":1,"wrongPlace":1},{"guess":[4,2,9],"rightPlace":0,"wrongPlace":0},{"guess":[5,2,0],"rightPlace":0,"wrongPlace":0},{"guess":[2,8,7],"rightPlace":1,"wrongPlace":0}],"answer":[3,1,7],"explanation":["321: 3 is in the right spot; 1 is in the code but placed differently.","429: none of 4, 2, 9 appear in the code.","520: none of 5, 2, 0 appear in the code.","287: 7 is in the right spot."],"hint":"The last digit is odd."}]}